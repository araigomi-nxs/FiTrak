<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="layouts.calculator.basic.CyclingWorkoutCalculator">
  <grid id="27dc6" binding="MainPanel" layout-manager="CardLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="405"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="160d6" binding="JPanel2" layout-manager="GridLayoutManager" row-count="10" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="20" left="20" bottom="10" right="20"/>
        <constraints>
          <card name="Card1"/>
        </constraints>
        <properties>
          <background color="-723724"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="d1ea2" class="javax.swing.JLabel" binding="DurationLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Duration (m)"/>
            </properties>
          </component>
          <component id="9c898" class="javax.swing.JLabel" binding="DistanceLabel">
            <constraints>
              <grid row="2" column="0" row-span="2" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Distance (km)"/>
            </properties>
          </component>
          <component id="5d076" class="javax.swing.JTextField" binding="DistanceField">
            <constraints>
              <grid row="2" column="1" row-span="2" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="63e4d" class="javax.swing.JButton" binding="CalculateButton">
            <constraints>
              <grid row="7" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-2300873"/>
              <text value="Calculate"/>
            </properties>
          </component>
          <component id="c1521" class="javax.swing.JLabel" binding="IntensityLabel">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Intensity"/>
            </properties>
          </component>
          <component id="58d0f" class="javax.swing.JLabel" binding="TitleLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Cycling Calory Counter"/>
            </properties>
          </component>
          <component id="28087" class="javax.swing.JTextArea" binding="outputTextArea">
            <constraints>
              <grid row="9" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="20"/>
              </grid>
            </constraints>
            <properties>
              <editable value="false"/>
              <font name="Arial" size="11" style="0"/>
            </properties>
          </component>
          <component id="f84c6" class="javax.swing.JComboBox" binding="IntensityComboB">
            <constraints>
              <grid row="4" column="1" row-span="3" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <model>
                <item value="Normal"/>
                <item value="Vigorous"/>
              </model>
            </properties>
          </component>
          <component id="5f235" class="javax.swing.JLabel" binding="DurationDisplay">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value=""/>
            </properties>
          </component>
          <component id="fd94" class="javax.swing.JButton" binding="saveButton" default-binding="true">
            <constraints>
              <grid row="8" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-2300873"/>
              <text value="Save"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
