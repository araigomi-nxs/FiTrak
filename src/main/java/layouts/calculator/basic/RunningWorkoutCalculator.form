<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="layouts.calculator.basic.RunningWorkoutCalculator">
  <grid id="27dc6" binding="MainPanel" layout-manager="CardLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="f431f" binding="JPanel2" layout-manager="GridLayoutManager" row-count="12" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="20" left="20" bottom="10" right="20"/>
        <constraints>
          <card name="Card1"/>
        </constraints>
        <properties>
          <background color="-723724"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="cd246" class="javax.swing.JLabel" binding="TitleLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Running Calory Counter"/>
            </properties>
          </component>
          <component id="b3e71" class="javax.swing.JLabel" binding="DurationLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Duration (m)"/>
            </properties>
          </component>
          <component id="438e1" class="javax.swing.JTextField" binding="DistanceField">
            <constraints>
              <grid row="6" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="fbb7b" class="javax.swing.JLabel" binding="DistanceLabel">
            <constraints>
              <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Distance (km)"/>
            </properties>
          </component>
          <component id="2d0de" class="javax.swing.JComboBox" binding="IntensityComboB">
            <constraints>
              <grid row="7" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <model>
                <item value="Moderate"/>
                <item value="Vigorous"/>
              </model>
            </properties>
          </component>
          <component id="714e4" class="javax.swing.JLabel" binding="IntensityLabel">
            <constraints>
              <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Intensity"/>
            </properties>
          </component>
          <component id="2a12e" class="javax.swing.JLabel" binding="TerrainLabel">
            <constraints>
              <grid row="8" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Terrain"/>
            </properties>
          </component>
          <component id="d4492" class="javax.swing.JComboBox" binding="TerrainComboB">
            <constraints>
              <grid row="8" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <model>
                <item value="Flat"/>
                <item value="Uphill"/>
                <item value="Trail"/>
              </model>
            </properties>
          </component>
          <component id="7f985" class="javax.swing.JButton" binding="CalculateButton">
            <constraints>
              <grid row="9" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-2300873"/>
              <text value="Calculate "/>
            </properties>
          </component>
          <component id="9acc7" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Start"/>
            </properties>
          </component>
          <component id="924d4" class="javax.swing.JLabel">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="End"/>
            </properties>
          </component>
          <component id="86510" class="javax.swing.JFormattedTextField" binding="startTimeField">
            <constraints>
              <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="9b34" class="javax.swing.JFormattedTextField" binding="startDateField">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="84d5a" class="javax.swing.JFormattedTextField" binding="endTimeField">
            <constraints>
              <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="6850" class="javax.swing.JFormattedTextField" binding="endDateField">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <grid id="df844" binding="stopWatchArea" layout-manager="CardLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="11" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children/>
          </grid>
          <component id="96d11" class="javax.swing.JTextArea" binding="outputTextArea">
            <constraints>
              <grid row="10" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="20"/>
              </grid>
            </constraints>
            <properties>
              <editable value="false"/>
              <font name="Arial" size="11" style="0"/>
              <preferredSize width="1" height="50"/>
              <text value=""/>
            </properties>
          </component>
          <component id="7d199" class="javax.swing.JLabel" binding="DurationDisplay">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value=""/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
