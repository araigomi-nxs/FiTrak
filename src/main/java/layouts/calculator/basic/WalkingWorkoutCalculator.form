          </component>
          <grid id="938e5" binding="stopWatchArea" layout-manager="CardLayout" hgap="0" vgap="0">
            <constraints>
              <grid row="10" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
