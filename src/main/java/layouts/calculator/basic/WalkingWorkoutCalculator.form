<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="layouts.calculator.basic.WalkingWorkoutCalculator">
  <grid id="27dc6" binding="MainPanel" layout-manager="CardLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="710" height="708"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="a1d17" binding="JPanel2" layout-manager="GridLayoutManager" row-count="11" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="20" left="20" bottom="10" right="20"/>
        <constraints>
          <card name="Card1"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="90025" class="javax.swing.JLabel" binding="TitleLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Walking Calory Counter"/>
            </properties>
          </component>
          <component id="f996d" class="javax.swing.JTextField" binding="DurationField">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="9ce4a" class="javax.swing.JLabel" binding="DurationLabel">
            <constraints>
              <grid row="1" column="0" row-span="2" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Duration(m)"/>
            </properties>
          </component>
          <component id="8be5f" class="javax.swing.JTextField" binding="StepsField">
            <constraints>
              <grid row="6" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="2" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="94154" class="javax.swing.JLabel" binding="StepsLabel">
            <constraints>
              <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Steps"/>
            </properties>
          </component>
          <component id="2c64f" class="javax.swing.JLabel" binding="IntensityLabel">
            <constraints>
              <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Intensity"/>
            </properties>
          </component>
          <component id="7f9ca" class="javax.swing.JComboBox" binding="IntensityComboB">
            <constraints>
              <grid row="7" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <model>
                <item value="Calm"/>
                <item value="Brisk"/>
              </model>
            </properties>
          </component>
          <component id="f8d06" class="javax.swing.JLabel" binding="WeightLabel">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Weight (kg)"/>
            </properties>
          </component>
          <component id="5d6a2" class="javax.swing.JTextField" binding="WeightField">
            <constraints>
              <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="be284" class="javax.swing.JButton" binding="calculateButton" default-binding="true">
            <constraints>
              <grid row="8" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Calculate"/>
            </properties>
          </component>
          <component id="671b3" class="javax.swing.JTextArea" binding="outputTextArea">
            <constraints>
              <grid row="9" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="1" use-parent-layout="false">
                <preferred-size width="-1" height="20"/>
              </grid>
            </constraints>
            <properties>
              <editable value="false"/>
              <font name="Arial" size="11" style="0"/>
              <foreground color="-16777216"/>
              <lineWrap value="true"/>
              <margin top="0" left="0" bottom="0" right="0"/>
