<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="layouts.calculator.cardio.JumpingJacksCalculator">
  <grid id="27dc6" binding="MainPanel" layout-manager="CardLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="510"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="c8807" binding="Jpanel2" layout-manager="GridLayoutManager" row-count="12" column-count="9" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
