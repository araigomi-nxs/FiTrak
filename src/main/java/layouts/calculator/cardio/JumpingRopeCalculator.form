          <component id="9d9a1" class="javax.swing.JButton" binding="saveButton" default-binding="true">
            <constraints>
              <grid row="9" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="1" use-parent-layout="false"/>
            </constraints>
            <properties>
              <background color="-2300873"/>
              <text value="Save"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
