          </component>
          <component id="53647" class="javax.swing.JLabel" binding="SetsLabel">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Sets"/>
            </properties>
          </component>
          <component id="1f9f6" class="javax.swing.JLabel" binding="RepsLabel">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Reps (optional)"/>
            </properties>
          </component>
          <component id="a1154" class="javax.swing.JLabel" binding="RestTimeLabel">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
